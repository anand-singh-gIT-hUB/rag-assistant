# Application Environment (dev | prod)
APP_ENV=dev
ENABLE_EVALUATION=true

# API Configuration
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=huggingface

# Model Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage
CHROMA_PERSIST_DIR=app/storage/vectordb
FILES_DIR=app/storage/files
LOGS_DIR=app/storage/logs

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RERANKER_ENABLED=true

# Hybrid Retrieval (BM25 + Dense)
HYBRID_ENABLED=true   # Set to false for dense-only mode
BM25_TOP_K=20         # Candidate pool for BM25 before RRF fusion
